{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "palette": {
    "red": "#C22F28",
    "orange": "#F18032",
    "green": "#9DB667",
    "surface": "#272C38",
    "teal": "#9FD4CA",
    "ink": "#131320",
    "cream": "#F1ECDF",
    "path": "#171723"
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "powerline",
          "powerline_symbol": "",
          "leading_powerline_symbol": "🭨",
          "foreground": "p:cream",
          "background": "p:red",
          "template": "  "
        },
        {
          "type": "session",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:ink",
          "background": "p:orange",
          "template": " {{ .UserName }}{{ if .SSHSession }}@{{ .HostName }}{{ end }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:cream",
          "background": "p:surface",
          "template": " {{ .Path }} ",
          "options": {
            "style": "folder",
            "home_icon": "~"
          }
        },
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:teal",
          "background": "p:path",
          "template": " {{ .Name }} ",
          "options": {
            "mapped_shell_names": {
              "nushell": "nu"
            }
          }
        },
        {
          "type": "text",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "p:green",
          "background": "p:path",
          "template": "{{ if .Env.DEVENV_ROOT }}  devenv {{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "p:green",
          "template": " ❯ "
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "overflow": "hide",
      "segments": [
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "🭪",
          "leading_powerline_symbol": "",
          "foreground": "p:teal",
          "background": "p:path",
          "template": " {{ if .Detached }}{{ .ShortHash }}{{ else }}{{ .Ref }}{{ end }} ",
          "options": {
            "fetch_status": false
          }
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "powerline_symbol": "🭪",
          "leading_powerline_symbol": "",
          "foreground": "p:teal",
          "background": "p:surface",
          "template": " {{ .FormattedMs }} ",
          "options": {
            "always_enabled": true,
            "threshold": 0,
            "style": "austin"
          }
        }
      ]
    }
  ]
}
